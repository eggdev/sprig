{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "types": ["bun"]
  },
  "include": ["src", "test"]
}
